{
  "name": "shopease-auth-server",
  "version": "1.0.0",
  "description": "Authentication & authorization module extracted from the ShopEase API (Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/db/scripts/seedAdmin.js",
    "db:indexes": "node src/db/scripts/syncIndexes.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.3",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "morgan": "^1.12.1",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": { "nodemon": "^3.1.14" }
}
