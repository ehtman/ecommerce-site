meta {
  name: Health card flag
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("reports cardPaymentsEnabled", function () { expect(res.body.data.cardPaymentsEnabled).to.be.a('boolean'); });
  // Later requests expect other answers when cards are ON (real Stripe keys)
  bru.setEnvVar("cardEnabled", String(res.body.data.cardPaymentsEnabled));
}
