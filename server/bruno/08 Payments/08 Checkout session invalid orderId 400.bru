meta {
  name: Checkout session invalid orderId 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/payments/checkout-session
  body: json
  auth: bearer
}

auth:bearer {
  token: {{paymentsToken}}
}

body:json {
  {
    "orderId": "not-an-id"
  }
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("error is on orderId", function () { expect(res.body.errors[0].field).to.equal("orderId"); });
}
