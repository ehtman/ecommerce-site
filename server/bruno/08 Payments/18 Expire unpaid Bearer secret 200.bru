meta {
  name: Expire unpaid Bearer secret 200
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/payments/expire-unpaid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cronSecret}}
}

tests {
  test("status is 200 (CRON_SECRET in .env must equal cronSecret)", function () { expect(res.status).to.equal(200); });
  test("returns a summary", function () { expect(res.body.data).to.have.keys('checked', 'cancelled', 'skipped'); });
}
