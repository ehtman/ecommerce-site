meta {
  name: Deactivate (admin)
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/categories/{{categoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": false
  }
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("now inactive", function () { expect(res.body.data.isActive).to.equal(false); });
}
