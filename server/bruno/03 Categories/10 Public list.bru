meta {
  name: Public list (no token)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: none
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("contains our category and its child", function () {
    const ids = res.body.data.map((c) => c._id);
    expect(ids).to.include(bru.getEnvVar("categoryId"));
    expect(ids).to.include(bru.getEnvVar("childCategoryId"));
  });
}
