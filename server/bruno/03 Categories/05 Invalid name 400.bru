meta {
  name: Invalid name → 400
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "A"
  }
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("names the field", function () { expect(res.body.errors[0].field).to.equal("name"); });
}
