meta {
  name: Admin – create category (for the test product)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{couponCategoryName}}"
  }
}

script:pre-request {
  bru.setEnvVar('couponCategoryName', 'Coupon Category ' + Date.now());
}

tests {
  test('status is 201', function () { expect(res.status).to.eql(201); });
  bru.setEnvVar('couponCategoryId', res.body.data._id);
}
