meta {
  name: Cart – add 1 more (Rs 4,000)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{couponToken}}
}

body:json {
  {
    "productId": "{{couponProductId}}",
    "quantity": 1
  }
}

tests {
  test('status is 200', function () { expect(res.status).to.eql(200); });
  test('subtotal is 4000', function () { expect(res.body.data.subtotal).to.eql(4000); });
}
