meta {
  name: Admin login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/admin/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  test('status is 200 (run npm run seed:admin first)', function () { expect(res.status).to.eql(200); });
  bru.setEnvVar('adminToken', res.body.data.token);
}
