meta {
  name: Coupons – create fixed Rs 300 (second coupon)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/coupons
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "code": "{{couponCode2}}",
    "type": "fixed",
    "value": 300,
    "usageLimit": 1,
    "expiresAt": "2030-12-31T23:59:59Z"
  }
}

script:pre-request {
  bru.setEnvVar('couponCode2', 'BR' + 'F' + Date.now().toString(36).toUpperCase());
}

tests {
  test('status is 201', function () { expect(res.status).to.eql(201); });
  bru.setEnvVar('couponId2', res.body.data._id);
}
