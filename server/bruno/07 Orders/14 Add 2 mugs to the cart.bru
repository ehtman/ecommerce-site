meta {
  name: Add 2 mugs to the cart
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orderToken}}
}

body:json {
  {
    "productId": "{{orderProductId}}",
    "quantity": 2
  }
}

tests {
  test('status is 200', () => expect(res.status).to.equal(200));
}
