meta {
  name: Customer cannot cancel while processing → 400
  type: http
  seq: 31
}

patch {
  url: {{baseUrl}}/orders/{{orderId2}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orderToken}}
}

body:json {
  {}
}

tests {
  test('status is 400', () => expect(res.status).to.equal(400));
  test('too late', () => expect(res.body.message).to.equal('Orders that are processing can no longer be cancelled'));
}
