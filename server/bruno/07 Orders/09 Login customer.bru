meta {
  name: Login customer
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{orderEmail}}",
    "password": "secret123"
  }
}

tests {
  test('status is 200', () => expect(res.status).to.equal(200));
  test('email is verified', () => expect(res.body.data.user.isEmailVerified).to.equal(true));
  bru.setEnvVar('orderToken', res.body.data.token);
}
