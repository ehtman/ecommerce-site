meta {
  name: Register other customer
  type: http
  seq: 35
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Other Buyer",
    "email": "{{orderOtherEmail}}",
    "password": "secret123"
  }
}

script:pre-request {
  bru.setEnvVar('orderOtherEmail', 'orders.other' + Date.now() + '@example.com');
}

tests {
  test('status is 201', () => expect(res.status).to.equal(201));
  bru.setEnvVar('orderOtherToken', res.body.data.token);
}
