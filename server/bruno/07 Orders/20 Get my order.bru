meta {
  name: Get my order
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{orderToken}}
}

tests {
  test('status is 200', () => expect(res.status).to.equal(200));
  test('address snapshot', () => expect(res.body.data.shippingAddress.city).to.equal('Lahore'));
}
