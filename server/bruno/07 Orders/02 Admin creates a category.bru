meta {
  name: Admin creates a category
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{orderAdminToken}}
}

body:json {
  {
    "name": "{{orderCategoryName}}",
    "description": "Created by the orders folder"
  }
}

script:pre-request {
  bru.setEnvVar('orderCategoryName', 'Orders ' + Date.now());
}

tests {
  test('status is 201', () => expect(res.status).to.equal(201));
  bru.setEnvVar('orderCategoryId', res.body.data._id);
}
