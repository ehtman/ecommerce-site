meta {
  name: Wishlist – remove A
  type: http
  seq: 31
}

delete {
  url: {{baseUrl}}/wishlist/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cartToken}}
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 200", function () { expect(status).to.eql(200); });
  test("empty again", function () { expect(j.data.productIds.length).to.eql(0); });
}
