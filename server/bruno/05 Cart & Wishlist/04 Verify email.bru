meta {
  name: Verify email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{verifyToken}}"
  }
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 200", function () { expect(status).to.eql(200); });
  test("now verified", function () { expect(j.data.isEmailVerified).to.eql(true); });
}
