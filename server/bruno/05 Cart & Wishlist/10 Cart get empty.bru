meta {
  name: Cart – get (empty, created at registration)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cartToken}}
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 200", function () { expect(status).to.eql(200); });
  test("no items", function () { expect(j.data.items.length).to.eql(0); });
  test("total is 0", function () { expect(j.data.total).to.eql(0); });
}
