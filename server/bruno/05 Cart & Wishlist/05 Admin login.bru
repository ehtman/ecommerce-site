meta {
  name: Admin login
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/admin/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 200", function () { expect(status).to.eql(200); });
  bru.setEnvVar("adminToken", j.data.token);
}
