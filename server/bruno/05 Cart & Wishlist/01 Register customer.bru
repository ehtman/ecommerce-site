meta {
  name: Register customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Cart Tester",
    "email": "{{cartEmail}}",
    "password": "secret123"
  }
}

script:pre-request {
  // This folder creates its OWN customer, so it can run on its own
  bru.setEnvVar('cartEmail', 'bruno.cart' + Date.now() + '@example.com');
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 201", function () { expect(status).to.eql(201); });
  bru.setEnvVar("cartToken", j.data.token);
}
