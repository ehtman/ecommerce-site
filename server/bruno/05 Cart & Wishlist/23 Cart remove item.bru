meta {
  name: Cart – remove B
  type: http
  seq: 23
}

delete {
  url: {{baseUrl}}/cart/items/{{productId2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cartToken}}
}

tests {
  const status = res.status;
  const j = res.body;
  test("status is 200", function () { expect(status).to.eql(200); });
  test("one line left", function () { expect(j.data.items.length).to.eql(1); });
  test("shipping is back", function () { expect(j.data.shipping).to.eql(250); });
}
