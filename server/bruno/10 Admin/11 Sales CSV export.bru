meta {
  name: Sales report – CSV export
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/admin/reports/sales/export?from=2026-01-01&to=2026-01-31
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("it is a CSV file", function () { expect(res.headers["content-type"]).to.equal("text/csv; charset=utf-8"); });
  test("downloaded with a dated file name", function () { expect(res.headers["content-disposition"]).to.equal('attachment; filename="sales-report_2026-01-01_2026-01-31.csv"'); });
  test("starts with the header line", function () { expect(String(res.body).replace(/^\uFEFF/, "").startsWith("period,orders,itemsSold,revenue,averageOrderValue")).to.equal(true); });
}
