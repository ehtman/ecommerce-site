meta {
  name: Low stock – default threshold
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/admin/products/low-stock
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("every product has stock ≤ 5", function () { res.body.data.forEach((p) => expect(p.stock).to.be.at.most(5)); });
}
