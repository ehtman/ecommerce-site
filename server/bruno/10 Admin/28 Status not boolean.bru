meta {
  name: Status – isActive as text → 400
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/admin/users/{{admCustomerId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isActive": "true"
  }
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
}
