meta {
  name: Customers – search our customer
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/admin/users?search={{admCustomerEmail}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("exactly our customer, active, no orders yet", function () { expect(res.body.data.length).to.equal(1); expect(res.body.data[0]._id).to.equal(bru.getEnvVar("admCustomerId")); expect(res.body.data[0].orderCount).to.equal(0); });
}
