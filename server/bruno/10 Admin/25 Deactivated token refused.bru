meta {
  name: Status – deactivated customer's token → 403
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admCustomerToken}}
}

tests {
  test("status is 403", function () { expect(res.status).to.equal(403); });
  test("Account disabled", function () { expect(res.body.message).to.equal("Account disabled"); });
}
