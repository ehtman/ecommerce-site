meta {
  name: Catalogue – products (inactive too, paged)
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/admin/products?limit=5
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("limit 5 respected", function () { expect(res.body.data.length).to.be.at.most(5); });
  test("meta.limit is 5", function () { expect(res.body.meta.limit).to.equal(5); });
}
