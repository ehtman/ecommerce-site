meta {
  name: Update profile invalid phone
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/users/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "phone": "12345"
  }
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("error is about phone", function () { expect(res.body.errors[0].field).to.equal("phone"); });
}
