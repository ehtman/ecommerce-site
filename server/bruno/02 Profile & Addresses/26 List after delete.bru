meta {
  name: List after delete
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/addresses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("four left", function () { expect(res.body.data).to.have.length(4); });
  test("still exactly one default, listed first", function () {
    expect(res.body.data.filter(function (a) { return a.isDefault; })).to.have.length(1);
    expect(res.body.data[0].isDefault).to.equal(true);
  });
}
