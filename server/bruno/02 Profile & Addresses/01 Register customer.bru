meta {
  name: Register customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Address Tester",
    "email": "{{customerEmail}}",
    "password": "secret123"
  }
}

script:pre-request {
  // This folder creates its OWN customer, so it can run on its own
  bru.setEnvVar("customerEmail", "bruno.addr" + Date.now() + "@example.com");
}

tests {
  test("status is 201", function () { expect(res.status).to.equal(201); });
  bru.setEnvVar("customerToken", res.body.data.token);
}
