meta {
  name: Other customer updates my address → 404
  type: http
  seq: 21
}

put {
  url: {{baseUrl}}/addresses/{{addressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

body:json {
  {
    "label": "Home",
    "fullName": "Bruno Customer",
    "phone": "03001234567",
    "addressLine1": "House 12, Street 4, Gulberg III",
    "city": "Hacked",
    "province": "Punjab",
    "postalCode": "54000"
  }
}

tests {
  test("status is 404", function () { expect(res.status).to.equal(404); });
}
