meta {
  name: Login with the new password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
  bru.setEnvVar("token", res.body.data.token);
}
