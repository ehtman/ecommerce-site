meta {
  name: Reset password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setEnvVar("password", "newpass123");
}

tests {
  test("status is 200", function () { expect(res.status).to.equal(200); });
}
