meta {
  name: Second review of the same product → 409
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/products/{{reviewProductId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewCustomerToken}}
}

body:json {
  {
    "rating": 1,
    "title": "Boils fast",
    "comment": "Boils a full kettle in about three minutes. Very happy."
  }
}

tests {
  test("status is 409", function () { expect(res.status).to.equal(409); });
}
