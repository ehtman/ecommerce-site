meta {
  name: Eligibility – not delivered yet → canReview false
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/products/{{reviewProductId}}/reviews/eligibility
  body: none
  auth: bearer
}

auth:bearer {
  token: {{reviewCustomerToken}}
}

tests {
  const rb = res.body; // rb = response body
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("cannot review yet", function () { expect(rb.data.canReview).to.eql(false); });
}
