meta {
  name: Admin – hide the review
  type: http
  seq: 31
}

patch {
  url: {{baseUrl}}/reviews/{{reviewId}}/visibility
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "isVisible": false
  }
}

tests {
  const rb = res.body; // rb = response body
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("hidden", function () { expect(rb.data.isVisible).to.eql(false); });
}
