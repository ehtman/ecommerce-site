meta {
  name: Admin – move order to delivered
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/admin/orders/{{reviewOrderId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "delivered"
  }
}

tests {
  const rb = res.body; // rb = response body
  test("status is 200", function () { expect(res.status).to.equal(200); });
  test("order is delivered", function () { expect(rb.data.status).to.eql("delivered"); });
}
