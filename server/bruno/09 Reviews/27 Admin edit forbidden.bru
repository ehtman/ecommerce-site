meta {
  name: Admin cannot edit a review → 403
  type: http
  seq: 27
}

put {
  url: {{baseUrl}}/reviews/{{reviewId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "rating": 5,
    "title": "Boils fast",
    "comment": "Boils a full kettle in about three minutes. Very happy."
  }
}

tests {
  test("status is 403", function () { expect(res.status).to.equal(403); });
}
