meta {
  name: Admin login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/admin/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

tests {
  const rb = res.body; // rb = response body
  test("status is 200", function () { expect(res.status).to.equal(200); });
  bru.setEnvVar("adminToken", rb.data.token);
}
