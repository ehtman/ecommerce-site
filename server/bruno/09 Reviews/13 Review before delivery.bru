meta {
  name: Review before delivery → 403
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/products/{{reviewProductId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{reviewCustomerToken}}
}

body:json {
  {
    "rating": 5,
    "title": "Boils fast",
    "comment": "Boils a full kettle in about three minutes. Very happy."
  }
}

tests {
  test("status is 403", function () { expect(res.status).to.equal(403); });
}
