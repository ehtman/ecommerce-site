meta {
  name: Delete category in use → 400
  type: http
  seq: 34
}

delete {
  url: {{baseUrl}}/categories/{{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("explains why", function () { expect(/product\(s\) use this category/.test(res.body.message)).to.eql(true); });
}
