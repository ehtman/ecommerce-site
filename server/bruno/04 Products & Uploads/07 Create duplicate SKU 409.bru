meta {
  name: Create – duplicate SKU → 409
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Postman Copy pm{{productRunId}}",
    "description": "A soft cotton shirt created by the API test collection.",
    "brand": "PostmanBrand",
    "sku": "pm-{{productRunId}}-a",
    "price": 1500,
    "compareAtPrice": 2000,
    "category": "{{categoryId}}",
    "stock": 20,
    "images": [
      {
        "url": "https://res.cloudinary.com/demo/image/upload/shopease/products/postman-a.jpg",
        "publicId": "shopease/products/postman-a"
      }
    ],
    "specifications": [
      {
        "key": "Material",
        "value": "Cotton"
      }
    ],
    "isFeatured": true
  }
}

tests {
  test("status is 409", function () { expect(res.status).to.equal(409); });
  test("error is on sku", function () { expect(res.body.errors[0].field).to.eql('sku'); });
}
