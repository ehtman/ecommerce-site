meta {
  name: Upload – no file → 400
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/uploads/image?folder=products
  body: multipartForm
  auth: bearer
}

params:query {
  folder: products
}

auth:bearer {
  token: {{adminToken}}
}

body:multipart-form {
  note: no file attached
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("error is on image", function () { expect(res.body.errors[0].field).to.eql('image'); });
}
