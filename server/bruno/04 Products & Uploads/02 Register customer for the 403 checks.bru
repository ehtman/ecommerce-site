meta {
  name: Register customer (for the 403 checks)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Product Shopper",
    "email": "{{customerEmail}}",
    "password": "secret123"
  }
}

script:pre-request {
  bru.setEnvVar("customerEmail", 'products' + Date.now() + '@example.com');
}

tests {
  test("status is 201", function () { expect(res.status).to.equal(201); });
  bru.setEnvVar("customerToken", res.body.data.token);
}
