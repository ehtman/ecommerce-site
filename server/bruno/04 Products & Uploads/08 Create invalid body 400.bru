meta {
  name: Create – invalid body → 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Postman Shirt pm{{productRunId}}",
    "description": "A soft cotton shirt created by the API test collection.",
    "brand": "PostmanBrand",
    "sku": "PM-{{productRunId}}-X",
    "price": 0,
    "compareAtPrice": 2000,
    "category": "{{categoryId}}",
    "stock": 20,
    "images": [],
    "specifications": [
      {
        "key": "Material",
        "value": "Cotton"
      }
    ],
    "isFeatured": true
  }
}

tests {
  test("status is 400", function () { expect(res.status).to.equal(400); });
  test("price and images rejected", function () { expect(res.body.errors.map((e) => e.field).sort().join(',')).to.eql('images,price'); });
}
