meta {
  name: Create – without token → 401
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Postman Shirt pm{{productRunId}}",
    "description": "A soft cotton shirt created by the API test collection.",
    "brand": "PostmanBrand",
    "sku": "PM-{{productRunId}}-Z",
    "price": 1500,
    "compareAtPrice": 2000,
    "category": "{{categoryId}}",
    "stock": 20,
    "images": [
      {
        "url": "https://res.cloudinary.com/demo/image/upload/shopease/products/postman-a.jpg",
        "publicId": "shopease/products/postman-a"
      }
    ],
    "specifications": [
      {
        "key": "Material",
        "value": "Cotton"
      }
    ],
    "isFeatured": true
  }
}

tests {
  test("status is 401", function () { expect(res.status).to.equal(401); });
}
