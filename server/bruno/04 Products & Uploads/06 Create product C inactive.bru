meta {
  name: Create product C (inactive)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Postman Hidden pm{{productRunId}}",
    "description": "A soft cotton shirt created by the API test collection.",
    "brand": "PostmanBrand",
    "sku": "PM-{{productRunId}}-C",
    "price": 1200,
    "compareAtPrice": 2000,
    "category": "{{categoryId}}",
    "stock": 20,
    "images": [
      {
        "url": "https://res.cloudinary.com/demo/image/upload/shopease/products/postman-c.jpg",
        "publicId": "shopease/products/postman-c"
      }
    ],
    "specifications": [
      {
        "key": "Material",
        "value": "Cotton"
      }
    ],
    "isFeatured": true,
    "isActive": false
  }
}

tests {
  test("status is 201", function () { expect(res.status).to.equal(201); });
  bru.setEnvVar("inactiveId", res.body.data._id);
  bru.setEnvVar("inactiveSlug", res.body.data.slug);
}
