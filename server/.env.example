# =====================================================================
# server/.env.example – copy to server/.env and fill in your values:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux / Git Bash:  cp .env.example .env
# .env holds SECRETS and is ignored by git. Never commit it.
# =====================================================================

# ---------- App ----------
NODE_ENV=development
PORT=5000
# Frontend URL (used for CORS and for links inside emails). Comma-separated list allowed.
CLIENT_URL=http://localhost:5173

# ---------- Database (MongoDB Atlas) ----------
# Atlas → your cluster → Connect → Drivers → copy the string.
# Add the DATABASE NAME after the host (here: /shopease), and allow your IP in
# Atlas → Network Access. See docs/guides/setup-atlas.md
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shopease?retryWrites=true&w=majority

# ---------- Auth ----------
# Use a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=1d

# ---------- Seed admin (npm run seed:admin) ----------
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@shopease.pk
ADMIN_PASSWORD=Admin12345

# ---------- Email (Mailpit in Docker during development) ----------
# Start Mailpit from the repo root:  docker compose up -d   → inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopEase <no-reply@shopease.pk>"

# ---------- Google login (optional) ----------
# Leave empty to disable Google sign-in. See docs/guides/setup-google-login.md
GOOGLE_CLIENT_ID=

# ---------- Cloudinary image uploads (optional) ----------
# Free account at https://cloudinary.com → Dashboard → "API Keys". Leave empty to run
# without uploads (POST /api/uploads/image then answers 500 "Cloudinary is not configured").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Rate limiting ----------
# true = on (always in production). Set to false while running the Postman/Newman
# collection many times in a row, otherwise login/register return 429 after 10 tries.
RATE_LIMIT_ENABLED=true

# ---------- Payments ----------
# Card payments (Stripe) arrive in branch 08. Keep this false until then: orders with
# paymentMethod CARD are refused, Cash on Delivery (COD) always works.
PAYMENT_CARD_ENABLED=false
